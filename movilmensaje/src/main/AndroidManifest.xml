<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proyecto"
        android:usesCleartextTraffic="true">

        <!-- Entrada visual y funcional de FitTrack (diseño y flujo de login) -->
        <activity
            android:name="com.example.proyecto.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.proyecto.Principal"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.usuarios.nuevo.NuevoUsuarioActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.registro.RegistroActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.recuperar.RecuperarPasswordActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.entrenamiento.EntrenamientoActivoActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.entrenamiento.ResumenEntrenamientoActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.rutinas.nueva.NuevaRutinaActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.rutinas.detalle.DetalleRutinaActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.progreso.objetivo.ConfigurarObjetivoActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.progreso.detalle.DetalleSesionActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.calendario.programar.ProgramarEntrenamientoActivity"
            android:exported="false" />

        <activity
            android:name="com.example.proyecto.ui.perfil.editar.EditarPerfilActivity"
            android:exported="false" />

        <service
            android:name="com.example.proyecto.data.wear.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/fittrack" />
            </intent-filter>
        </service>

        <!-- Actividad base original (mensajería probada), conservada sin cambios de código,
             disponible para pruebas manuales pero ya no es la pantalla de lanzamiento -->
        <activity
            android:name=".MainActivityTest"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>

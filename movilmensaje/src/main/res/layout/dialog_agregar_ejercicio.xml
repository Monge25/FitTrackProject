<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#070B12"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloDialogEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar ejercicio"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Configura las series, repeticiones y descanso."
            android:textColor="#8D99A8"
            android:textSize="14sp"/>

        <!-- NOMBRE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del ejercicio"
            android:textColor="#B7C0CD"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundColor="#0B0F16"
            app:boxStrokeColor="@color/selector_box_stroke"
            app:boxCornerRadiusTopStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusBottomEnd="18dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreEjercicioDialog"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Ej. Press de banca"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#5B6675"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- SERIES Y REPETICIONES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Series"
                    android:textColor="#B7C0CD"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#0B0F16"
                    app:boxStrokeColor="@color/selector_box_stroke"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSeriesEjercicioDialog"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="4"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5B6675"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repeticiones"
                    android:textColor="#B7C0CD"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#0B0F16"
                    app:boxStrokeColor="@color/selector_box_stroke"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRepeticionesEjercicioDialog"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="10"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5B6675"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- PESO Y DESCANSO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peso (opcional)"
                    android:textColor="#B7C0CD"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#0B0F16"
                    app:boxStrokeColor="@color/selector_box_stroke"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:hintEnabled="false"
                    app:suffixText="kg"
                    app:suffixTextColor="#5B9BFF">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPesoEjercicioDialog"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="0"
                        android:inputType="numberDecimal"
                        android:paddingStart="16dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5B6675"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descanso"
                    android:textColor="#B7C0CD"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#0B0F16"
                    app:boxStrokeColor="@color/selector_box_stroke"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:hintEnabled="false"
                    app:suffixText="s"
                    app:suffixTextColor="#5B9BFF">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescansoEjercicioDialog"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="60"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5B6675"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- NOTAS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Notas (opcional)"
            android:textColor="#B7C0CD"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundColor="#0B0F16"
            app:boxStrokeColor="@color/selector_box_stroke"
            app:boxCornerRadiusTopStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusBottomEnd="18dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotasEjercicioDialog"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="top"
                android:hint="Ej. Bajar el peso con control"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5B6675"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTÓN GUARDAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarEjercicioDialog"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="26dp"
            android:text="Guardar ejercicio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#2F7BFF"
            app:cornerRadius="20dp"
            app:elevation="5dp"/>

        <!-- BOTÓN CANCELAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarEjercicioDialog"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#2F7BFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#151B26"
            app:cornerRadius="20dp"
            app:strokeColor="#2F7BFF"
            app:strokeWidth="1dp"/>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#070B12"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_encabezado_dashboard"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="EQUIPO FITTRACK"
                android:textColor="#2F7BFF"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTituloDialogUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nuevo usuario"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSubtituloDialogUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Registra un integrante del equipo FitTrack."
                android:textColor="#B7C0CD"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- FORMULARIO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- NOMBRE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre completo"
                android:textColor="#B7C0CD"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="#0B0F16"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/selector_box_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreUsuarioDialog"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Ej. Alexa Gastélum"
                    android:inputType="textPersonName"
                    android:paddingStart="16dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5B6675"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CORREO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Correo electrónico"
                android:textColor="#B7C0CD"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="#0B0F16"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/selector_box_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreoUsuarioDialog"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="correo@fittrack.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5B6675"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ROL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Rol del usuario"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#151B26"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#263242"
                app:strokeWidth="1dp">

                <RadioGroup
                    android:id="@+id/rgRolUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <RadioButton
                        android:id="@+id/rbAdministrador"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#2F7BFF"
                        android:text="Administrador"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>

                    <RadioButton
                        android:id="@+id/rbOperador"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#2F7BFF"
                        android:checked="true"
                        android:text="Operador"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>

                </RadioGroup>

            </com.google.android.material.card.MaterialCardView>

            <!-- ESTADO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#151B26"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#263242"
                app:strokeWidth="1dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchUsuarioActivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:text="Usuario activo"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:thumbTint="#2F7BFF"
                    app:trackTint="#4A5A75"/>

            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressDialogUsuario"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#2F7BFF"
                android:visibility="gone"/>

            <!-- BOTÓN GUARDAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarUsuarioDialog"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="26dp"
                android:text="Guardar usuario"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#2F7BFF"
                app:cornerRadius="22dp"
                app:elevation="5dp"/>

            <!-- BOTÓN ELIMINAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarUsuarioDialog"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="Eliminar usuario"
                android:textAllCaps="false"
                android:textColor="#FF6B81"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#151B26"
                app:cornerRadius="22dp"
                app:strokeColor="#FF6B81"
                app:strokeWidth="1dp"/>

            <!-- BOTÓN CANCELAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarUsuarioDialog"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#2F7BFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#151B26"
                app:cornerRadius="22dp"
                app:strokeColor="#2F7BFF"
                app:strokeWidth="1dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B12"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- ENCABEZADO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_encabezado_dashboard"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="34dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_chip_translucido"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="FITTRACK TRAINING"
                    android:textColor="#2F7BFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvDetalleNombreRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PUSH DAY"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDetalleDescripcionRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pecho, hombro y tríceps"
                android:textColor="#B7C0CD"
                android:textSize="15sp"/>

        </LinearLayout>

        <!-- INFORMACIÓN -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="-30dp"
            android:layout_marginEnd="18dp"
            app:cardBackgroundColor="#151B26"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="#263242"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIVEL"
                        android:textColor="#8B97A8"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvDetalleNivelRutina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Intermedio"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#263242"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DURACIÓN"
                        android:textColor="#8B97A8"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvDetalleDuracionRutina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="60 min"
                        android:textColor="#2F7BFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#263242"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EJERCICIOS"
                        android:textColor="#8B97A8"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvDetalleEjerciciosRutina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="6 ejercicios"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- EJERCICIOS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="30dp"
            android:text="Plan de entrenamiento"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="5dp"
            android:text="Ejercicios incluidos en esta rutina"
            android:textColor="#9AA5B5"
            android:textSize="14sp"/>

        <ProgressBar
            android:id="@+id/progressDetalleRutina"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:indeterminateTint="#2F7BFF"/>

        <!-- EJERCICIOS (dinámico) -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetalleEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:visibility="gone"
            tools:listitem="@layout/item_detalle_ejercicio"/>

        <TextView
            android:id="@+id/tvDetalleSinEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:background="@drawable/edittext_dark"
            android:gravity="center"
            android:padding="24dp"
            android:text="Esta rutina todavía no tiene ejercicios."
            android:textColor="#8D99A8"
            android:textSize="14sp"
            android:visibility="gone"/>

        <!-- BOTÓN PRINCIPAL -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmpezarEntrenamiento"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="18dp"
            android:text="EMPEZAR ENTRENAMIENTO"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#2F7BFF"
            app:cornerRadius="22dp"
            app:elevation="5dp"
            app:icon="@drawable/ic_fitness"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="#FFFFFF"/>

        <!-- BOTÓN SECUNDARIO -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverRutinas"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:text="Volver a rutinas"
            android:textAllCaps="false"
            android:textColor="#2F7BFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#151B26"
            app:cornerRadius="22dp"
            app:strokeColor="#2F7BFF"
            app:strokeWidth="1dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>